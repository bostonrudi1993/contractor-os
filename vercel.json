{
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/sign-in/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up/:path*",
      "destination": "/index.html"
    }
  ]
}